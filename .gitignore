# ==========================================
# GITHUB REPOSITORY ISOLATION (v5.3)
# ==========================================

# 1. Ambientes Virtuais e Scripts Locais
venv/
.pyenv/
*.pyc
__pycache__/

# 2. Work in Progress & Fila (Estritamente Local)
content/agendados/
.deploy_backups/

# 3. Artefatos de Build, Compilação e Node.js (Essencial!)
# Impede que os builds locais e pacotes do NPM subam para o repositório
docs/
public/
resources/
.hugo_build.lock
node_modules/

# 4. Metadados de Sistema e IDE
.DS_Store
.vscode/
.idea/

# 5. Relatórios de auditoria e artefatos de runtime
reports/
*.csv